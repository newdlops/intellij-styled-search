{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "out",
    "incremental": true,
    "tsBuildInfoFile": "out/test/tsconfig.tsbuildinfo",
    "lib": ["ES2020"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "mocha"]
  },
  "exclude": ["node_modules", ".vscode-test"]
}
